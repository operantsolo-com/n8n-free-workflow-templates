{
  "name": "OperantSolo - Binary data missing-file lab",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        120,
        300
      ]
    },
    {
      "id": "sample",
      "name": "Sample text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{text:\"OperantSolo binary lab\\nrecord_id: B001\\nstatus: ready\\n\"}}];"
      },
      "position": [
        360,
        300
      ]
    },
    {
      "id": "file",
      "name": "Build report file",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "parameters": {
        "operation": "toText",
        "sourceProperty": "text",
        "binaryPropertyName": "report",
        "options": {
          "fileName": "operantsolo-report.txt",
          "encoding": "utf8"
        }
      },
      "position": [
        600,
        300
      ]
    },
    {
      "id": "transform",
      "name": "Keep file while editing JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item, index) => ({\n  json: { ...item.json, checked_by: 'OperantSolo lab' },\n  binary: item.binary,\n  pairedItem: { item: index },\n}));"
      },
      "position": [
        840,
        300
      ]
    },
    {
      "id": "verify",
      "name": "Verify file bytes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const key = 'report';\nconst expected = \"OperantSolo binary lab\\nrecord_id: B001\\nstatus: ready\\n\";\nconst output = [];\nfor (const [index, item] of $input.all().entries()) {\n  const keys = Object.keys(item.binary ?? {});\n  if (!item.binary?.[key]) {\n    output.push({json:{passed:false, reason:'missing_binary_key', expected_key:key, binary_keys:keys}, pairedItem:{item:index}});\n    continue;\n  }\n  const bytes = await this.helpers.getBinaryDataBuffer(index, key);\n  output.push({\n    json: {passed:bytes.toString('utf8') === expected, binary_keys:keys, file_name:item.binary[key].fileName, mime_type:item.binary[key].mimeType, byte_length:bytes.length, content:bytes.toString('utf8')},\n    binary:item.binary,\n    pairedItem:{item:index},\n  });\n}\nreturn output;"
      },
      "position": [
        1080,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Sample text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sample text": {
      "main": [
        [
          {
            "node": "Build report file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build report file": {
      "main": [
        [
          {
            "node": "Keep file while editing JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep file while editing JSON": {
      "main": [
        [
          {
            "node": "Verify file bytes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}