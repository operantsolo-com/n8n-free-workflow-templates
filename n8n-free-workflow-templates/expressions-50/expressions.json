[
  {
    "id": "e01",
    "group": "Read data",
    "task": "Read a field",
    "expression": "$json.customer.name",
    "expected": "Ada",
    "note": "Use the current item."
  },
  {
    "id": "e02",
    "group": "Read data",
    "task": "Read a nested value",
    "expression": "$json.customer.address.city",
    "expected": "London",
    "note": "Match the actual JSON path."
  },
  {
    "id": "e03",
    "group": "Read data",
    "task": "Missing field fallback",
    "expression": "$json.missing ?? 'Unknown'",
    "expected": "Unknown",
    "note": "Nullish fallback handles null and undefined."
  },
  {
    "id": "e04",
    "group": "Read data",
    "task": "Keep a valid zero",
    "expression": "$json.count ?? 10",
    "expected": 0,
    "note": "Do not use || when zero is valid."
  },
  {
    "id": "e05",
    "group": "Read data",
    "task": "Keep a valid false",
    "expression": "$json.enabled ?? true",
    "expected": false,
    "note": "False can be a real setting."
  },
  {
    "id": "e06",
    "group": "Read data",
    "task": "Use a fallback for blank text",
    "expression": "$json.empty || 'Untitled'",
    "expected": "Untitled",
    "note": "Here a blank string should use the fallback."
  },
  {
    "id": "e07",
    "group": "Read data",
    "task": "Check for a missing nested field",
    "expression": "$json.customer.phone?.number ?? 'Not supplied'",
    "expected": "Not supplied",
    "note": "Optional chaining avoids an absent nested object."
  },
  {
    "id": "e08",
    "group": "Read data",
    "task": "Read from a named node",
    "expression": "$('Sample input').first().json.customer.name",
    "expected": "Ada",
    "note": "first() deliberately selects the first item, not a matching item."
  },
  {
    "id": "e09",
    "group": "Read data",
    "task": "Read the first incoming item",
    "expression": "$input.first().json.body.post_id",
    "expected": 42,
    "note": "Use item linking for multiple independent records."
  },
  {
    "id": "e10",
    "group": "Read data",
    "task": "Count incoming items",
    "expression": "$input.all().length",
    "expected": 1,
    "note": "This fixture provides one item."
  },
  {
    "id": "e11",
    "group": "Clean text",
    "task": "Trim spaces",
    "expression": "$json.name.trim()",
    "expected": "Ada Lovelace",
    "note": "Requires a string."
  },
  {
    "id": "e12",
    "group": "Clean text",
    "task": "Normalize an email",
    "expression": "$json.email.trim().toLowerCase()",
    "expected": "ada@example.com",
    "note": "Lowercasing is a cleanup rule, not email validation."
  },
  {
    "id": "e13",
    "group": "Clean text",
    "task": "Uppercase a string",
    "expression": "$json.platform.toUpperCase()",
    "expected": "LINKEDIN",
    "note": "Useful for display labels."
  },
  {
    "id": "e14",
    "group": "Clean text",
    "task": "Build a simple slug",
    "expression": "$json.slug.toLowerCase().replace(/\\s+/g, '-')",
    "expected": "workflow-lab",
    "note": "For this ASCII fixture; not a full URL slug sanitizer."
  },
  {
    "id": "e15",
    "group": "Clean text",
    "task": "Split comma-separated text",
    "expression": "$json.message.split(',').map(x => x.trim())",
    "expected": [
      "red",
      "green",
      "blue"
    ],
    "note": "Returns an array."
  },
  {
    "id": "e16",
    "group": "Clean text",
    "task": "Join tags",
    "expression": "$json.tags.join(', ')",
    "expected": "n8n, api, n8n",
    "note": "Duplicates remain unless removed first."
  },
  {
    "id": "e17",
    "group": "Clean text",
    "task": "Replace a word",
    "expression": "$json.slug.replace('Lab', 'Guide')",
    "expected": "Workflow Guide",
    "note": "replace changes the first matching occurrence."
  },
  {
    "id": "e18",
    "group": "Clean text",
    "task": "Read the first three characters",
    "expression": "$json.name.trim().slice(0, 3)",
    "expected": "Ada",
    "note": "slice does not change the original string."
  },
  {
    "id": "e19",
    "group": "Clean text",
    "task": "Check whether text contains a word",
    "expression": "$json.slug.includes('Workflow')",
    "expected": true,
    "note": "Case-sensitive match."
  },
  {
    "id": "e20",
    "group": "Clean text",
    "task": "Encode a query value",
    "expression": "$json.email.trim().toLowerCase() && encodeURIComponent($json.email.trim().toLowerCase())",
    "expected": "ada%40example.com",
    "note": "Encode values rather than a whole URL."
  },
  {
    "id": "e21",
    "group": "Arrays and JSON",
    "task": "Remove duplicate strings",
    "expression": "[...new Set($json.tags)]",
    "expected": [
      "n8n",
      "api"
    ],
    "note": "Equality is case-sensitive."
  },
  {
    "id": "e22",
    "group": "Arrays and JSON",
    "task": "Keep active rows",
    "expression": "$json.items.filter(x => x.active === true)",
    "expected": [
      {
        "name": "A",
        "active": true,
        "price": 10
      },
      {
        "name": "C",
        "active": true,
        "price": 5
      }
    ],
    "note": "Checks boolean true."
  },
  {
    "id": "e23",
    "group": "Arrays and JSON",
    "task": "Read each row name",
    "expression": "$json.items.map(x => x.name)",
    "expected": [
      "A",
      "B",
      "C"
    ],
    "note": "Returns an array of names."
  },
  {
    "id": "e24",
    "group": "Arrays and JSON",
    "task": "Find one row",
    "expression": "$json.items.find(x => x.name === 'B')?.price ?? null",
    "expected": 20,
    "note": "find returns the first match."
  },
  {
    "id": "e25",
    "group": "Arrays and JSON",
    "task": "Count rows",
    "expression": "$json.items.length",
    "expected": 3,
    "note": "Use Array.isArray first if the field may have another type."
  },
  {
    "id": "e26",
    "group": "Arrays and JSON",
    "task": "Sum prices",
    "expression": "$json.items.reduce((sum, x) => sum + x.price, 0)",
    "expected": 35,
    "note": "Fixture prices are already numbers."
  },
  {
    "id": "e27",
    "group": "Arrays and JSON",
    "task": "Sort numbers safely",
    "expression": "[...$json.numbers].sort((a, b) => a - b)",
    "expected": [
      1,
      2,
      3
    ],
    "note": "Copy first to avoid mutating the source array."
  },
  {
    "id": "e28",
    "group": "Arrays and JSON",
    "task": "Take two rows",
    "expression": "$json.items.slice(0, 2)",
    "expected": [
      {
        "name": "A",
        "active": true,
        "price": 10
      },
      {
        "name": "B",
        "active": false,
        "price": 20
      }
    ],
    "note": "Returns a smaller array."
  },
  {
    "id": "e29",
    "group": "Arrays and JSON",
    "task": "Read object keys",
    "expression": "$json.customer && Object.keys($json.customer)",
    "expected": [
      "name",
      "address"
    ],
    "note": "This is an object, not all input item names."
  },
  {
    "id": "e30",
    "group": "Arrays and JSON",
    "task": "Convert an object to JSON text",
    "expression": "JSON.stringify($json.body)",
    "expected": "{\"post_id\":42}",
    "note": "Useful when a destination needs a string."
  },
  {
    "id": "e31",
    "group": "Numbers and conditions",
    "task": "Convert numeric text",
    "expression": "Number($json.amount)",
    "expected": 12.5,
    "note": "Validate blanks and non-numeric text before sending."
  },
  {
    "id": "e32",
    "group": "Numbers and conditions",
    "task": "Format two decimal places",
    "expression": "Number($json.amount).toFixed(2)",
    "expected": "12.50",
    "note": "toFixed returns text."
  },
  {
    "id": "e33",
    "group": "Numbers and conditions",
    "task": "Round up a duration",
    "expression": "Math.ceil(Number($json.amount))",
    "expected": 13,
    "note": "Useful when a wait unit needs a whole number."
  },
  {
    "id": "e34",
    "group": "Numbers and conditions",
    "task": "Pick a status label",
    "expression": "$json.status === 'paid' ? 'Ready' : 'Review'",
    "expected": "Ready",
    "note": "A simple two-way decision."
  },
  {
    "id": "e35",
    "group": "Numbers and conditions",
    "task": "Require two checks",
    "expression": "$json.status === 'paid' && $json.enabled === true",
    "expected": false,
    "note": "Both checks must pass."
  },
  {
    "id": "e36",
    "group": "Numbers and conditions",
    "task": "Accept either status",
    "expression": "['paid', 'pending'].includes($json.status)",
    "expected": true,
    "note": "Explicit allowed values."
  },
  {
    "id": "e37",
    "group": "Numbers and conditions",
    "task": "Check numeric validity",
    "expression": "Number.isFinite(Number($json.amount))",
    "expected": true,
    "note": "Blank text converts to zero; reject blanks separately."
  },
  {
    "id": "e38",
    "group": "Numbers and conditions",
    "task": "Build a stable demo key",
    "expression": "[$json.body.post_id, $json.platform, $json.account_id].join(':')",
    "expected": "42:linkedin:demo",
    "note": "Choose fields and escaping rules to avoid real-world collisions."
  },
  {
    "id": "e39",
    "group": "Numbers and conditions",
    "task": "Keep only selected fields",
    "expression": "({post_id:$json.body.post_id,platform:$json.platform})",
    "expected": {
      "post_id": 42,
      "platform": "linkedin"
    },
    "note": "Build the object a downstream service actually expects."
  },
  {
    "id": "e40",
    "group": "Numbers and conditions",
    "task": "Read names with JMESPath",
    "expression": "$jmespath($json, 'items[*].name')",
    "expected": [
      "A",
      "B",
      "C"
    ],
    "note": "JMESPath query; different syntax from JavaScript."
  },
  {
    "id": "e41",
    "group": "Dates and JMESPath",
    "task": "Filter with JMESPath",
    "expression": "$jmespath($json, 'items[?active == `true`].name')",
    "expected": [
      "A",
      "C"
    ],
    "note": "Backticks denote a JSON literal inside the query."
  },
  {
    "id": "e42",
    "group": "Dates and JMESPath",
    "task": "Sum with JMESPath",
    "expression": "$jmespath($json, 'sum(items[*].price)')",
    "expected": 35,
    "note": "The selected prices must be numbers."
  },
  {
    "id": "e43",
    "group": "Dates and JMESPath",
    "task": "Read an ISO date",
    "expression": "DateTime.fromISO($json.date, {zone:\"utc\"}).toISODate()",
    "expected": "2026-10-08",
    "note": "Use an explicit zone for repeatable output."
  },
  {
    "id": "e44",
    "group": "Dates and JMESPath",
    "task": "Format an ISO date",
    "expression": "DateTime.fromISO($json.date, {zone:\"utc\"}).toFormat(\"dd LLL yyyy\")",
    "expected": "08 Oct 2026",
    "note": "Month text follows the locale; this run used English."
  },
  {
    "id": "e45",
    "group": "Dates and JMESPath",
    "task": "Move an instant to another timezone",
    "expression": "DateTime.fromISO($json.date).setZone(\"Asia/Kolkata\").toFormat(\"HH:mm\")",
    "expected": "16:00",
    "note": "setZone preserves the instant and changes its display."
  },
  {
    "id": "e46",
    "group": "Dates and JMESPath",
    "task": "Add seven calendar days",
    "expression": "DateTime.fromISO($json.date, {zone:\"utc\"}).plus({days:7}).toISODate()",
    "expected": "2026-10-15",
    "note": "Calendar days can differ from 24-hour durations around DST."
  },
  {
    "id": "e47",
    "group": "Dates and JMESPath",
    "task": "Subtract one day",
    "expression": "DateTime.fromISO($json.date, {zone:\"utc\"}).minus({days:1}).toISODate()",
    "expected": "2026-10-07",
    "note": "Parse the date before doing date math."
  },
  {
    "id": "e48",
    "group": "Dates and JMESPath",
    "task": "Parse a known date format",
    "expression": "DateTime.fromFormat($json.localDate, \"dd/MM/yyyy\", {zone:\"utc\"}).toISODate()",
    "expected": "2026-10-08",
    "note": "Specify the format; 08/10 is ambiguous without it."
  },
  {
    "id": "e49",
    "group": "Dates and JMESPath",
    "task": "Convert Unix seconds",
    "expression": "DateTime.fromSeconds($json.unix, {zone:\"utc\"}).toISODate()",
    "expected": "2026-10-08",
    "note": "fromMillis is for milliseconds, not seconds."
  },
  {
    "id": "e50",
    "group": "Dates and JMESPath",
    "task": "Reject an invalid date",
    "expression": "DateTime.fromISO(\"not-a-date\").isValid",
    "expected": false,
    "note": "Route invalid input for review instead of booking from it."
  }
]