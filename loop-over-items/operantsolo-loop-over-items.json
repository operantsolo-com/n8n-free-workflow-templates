    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expected = $('Sample records').all().map(i => i.json.record_id);\nconst rows = $input.all().map(i => i.json);\nconst ids = rows.map(i => i.record_id);\nconst missing = expected.filter(id => !ids.includes(id));\nconst unexpected = ids.filter(id => !expected.includes(id));\nconst counts = new Map();\nfor (const id of ids) counts.set(id, (counts.get(id) || 0) + 1);\nconst duplicates = [...counts].filter(([,count]) => count > 1).map(([id]) => id);\nconst validInputIds = expected.every(id => typeof id === 'string' && id.length > 0) && new Set(expected).size === expected.length;\r\nconst passed = validInputIds && missing.length === 0 && unexpected.length === 0 && duplicates.length === 0 && rows.every(r => r.processed === true) && rows.length === expected.length;\nreturn [{json:{passed, valid_input_ids:validInputIds, expected_count:expected.length, returned_count:rows.length, returned_ids:ids, missing_ids:missing, duplicate_ids:duplicates, unexpected_ids:unexpected}}];"
      },
